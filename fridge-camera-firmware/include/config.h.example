#pragma once

// Copy this file to config.h and fill in your WiFi credentials
#define WIFI_SSID     "YOUR_WIFI_SSID"
#define WIFI_PASSWORD "YOUR_WIFI_PASSWORD"
// Backend server base URL (your PC IP on the same network, port 8000)
#define SERVER_URL    "http://192.168.1.100:8000"

// Unique ID of this camera (1-5). Each ESP32-CAM must get a different number
#define CAMERA_ID     1

// 1 = this board has the door sensor: it creates the event_id and tells the other cameras to capture.
// 0 = follower camera. Exactly ONE camera must be 1
#define IS_DOOR_MASTER 0
