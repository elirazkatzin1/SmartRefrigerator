# Usually NOT needed: the app finds the backend on the computer running `npx expo start`
# (same address, port 8000), on any network.
#
# Set this only to point the app at a different server, e.g. when using `npx expo start --tunnel`
# or a deployed backend. Copy to .env.local, then restart with `npx expo start --clear`.
# EXPO_PUBLIC_API_URL=https://my-backend.example.com/api/v1
